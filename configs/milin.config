# MiLin — конституция конфигурации (M2)
# каждый включённый пункт обязан доказать право на жизнь:
# ядро-минимум = бут + serial-консоль + ELF-инит из initramfs

# --- основа ---
CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_KERNEL_XZ=y

# --- диета M2: выключено осознанно ---
# ввод: ядро ничего не читает с устройств
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_HID_SUPPORT is not set
# графические консоли: живём на ttyS0
# CONFIG_VT is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_DUMMY_CONSOLE is not set
# псевдотерминалы
# CONFIG_UNIX98_PTYS is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_SERIAL_EARLYCON is not set
# файловые системы дайвинда: rootfs = ramfs из initramfs
# CONFIG_PROC_FS is not set
# CONFIG_SYSFS is not set
# CONFIG_TMPFS is not set
# sysctl без procfs не нужен
# CONFIG_SYSCTL is not set
# initramfs: только gzip, остальные декомпрессоры — лишние мегабайты
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# отладка и профилирование: ядро не самоед
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_OBJTOOL is not set
# CPU: без микрокода, vsyscall, IBT и pkeys
# CONFIG_MICROCODE is not set
# CONFIG_X86_MPPARSE is not set
# CONFIG_X86_VSYSCALL_EMULATION is not set
# CONFIG_X86_KERNEL_IBT is not set
# CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS is not set
# CONFIG_CPU_SUP_HYGON is not set
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
# планировщик и аллокатор: без вытеснения, плоская память
CONFIG_PREEMPT_NONE=y
CONFIG_FLATMEM=y
# CONFIG_SLAB_MERGE_DEFAULT is not set
# hardening с ценой в размере: выкл
CONFIG_INIT_STACK_NONE=y
# core dump'ы не нужны
# CONFIG_ELFCORE is not set
# memfd не нужен
# CONFIG_MEMFD_CREATE is not set
# DMA-зоны: PCI/блочных устройств нет
# CONFIG_ZONE_DMA32 is not set
# CONFIG_SWIOTLB is not set
# RTC-инфраструктура
# CONFIG_RTC_LIB is not set
