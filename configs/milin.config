# MiLin — конституция конфигурации (M2)
# каждый включённый пункт обязан доказать право на жизнь:
# ядро-минимум = бут + serial-консоль + ELF-инит из initramfs

# --- основа ---
CONFIG_64BIT=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_KERNEL_XZ=y

# --- диета M2: выключено осознанно ---
# ввод: ядро ничего не читает с устройств
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set
# CONFIG_HID_SUPPORT is not set
# графические консоли: живём на ttyS0
# CONFIG_VT is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_DUMMY_CONSOLE is not set
# псевдотерминалы
# CONFIG_UNIX98_PTYS is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_SERIAL_EARLYCON is not set
# файловые системы дайвинда: rootfs = ramfs из initramfs
# CONFIG_PROC_FS is not set
# CONFIG_SYSFS is not set
# CONFIG_TMPFS is not set
# sysctl без procfs не нужен
# CONFIG_SYSCTL is not set
# initramfs: только gzip, остальные декомпрессоры — лишние мегабайты
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# отладка и профилирование: ядро не самоед
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_OBJTOOL is not set
# CPU: без микрокода, vsyscall, IBT и pkeys
# CONFIG_MICROCODE is not set
# CONFIG_X86_MPPARSE is not set
# CONFIG_X86_VSYSCALL_EMULATION is not set
# CONFIG_X86_KERNEL_IBT is not set
# CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS is not set
# CONFIG_CPU_SUP_HYGON is not set
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
# планировщик и аллокатор: без вытеснения, плоская память
CONFIG_PREEMPT_NONE=y
CONFIG_FLATMEM=y
# CONFIG_SLAB_MERGE_DEFAULT is not set
# hardening с ценой в размере: выкл
CONFIG_INIT_STACK_NONE=y
# core dump'ы не нужны
# CONFIG_ELFCORE is not set
# memfd не нужен
# CONFIG_MEMFD_CREATE is not set
# DMA-зоны: PCI/блочных устройств нет
# CONFIG_ZONE_DMA32 is not set
# CONFIG_SWIOTLB is not set
# RTC-инфраструктура
# CONFIG_RTC_LIB is not set

# --- M4: userspace-изация — контракт серверов -------------------------------
# ядро отдаёт серверам устройства (UIO), файловые системы (FUSE) и пользователей
# (MULTIUSER); возвращаем не драйверы, а интерфейс, через который userspace
# ими управляет. PCI — шина: ядро только перечисляет устройства и отдаёт их
# uio_pci_generic, вся логика драйвера живёт в /sbin/uiod.
# devtmpfs: /dev/fuse и /dev/uio0 появляются сами (UIO берёт динамический
# major — без devtmpfs его не узнать).
# sysfs: интерфейс discovery для супервизора — uio_pci_generic не имеет
# таблицы device-id, привязка железа к userspace-драйверу делается
# записью в /sys/bus/pci/drivers/uio_pci_generic/new_id.
CONFIG_MULTIUSER=y
CONFIG_FUSE_FS=y
CONFIG_UIO=y
CONFIG_PCI=y
CONFIG_UIO_PCI_GENERIC=y
CONFIG_DEVTMPFS=y
CONFIG_SYSFS=y
# EXAR-варианты 8250 тянут eeprom_93cx6 из вырезанного drivers/misc
# CONFIG_SERIAL_8250_EXAR is not set

# --- M11: гостевой пакетный менеджер ----------------------------------------
# xbps-install ставит файловую блокировку на /var/db/xbps/lock (flock/fcntl
# F_SETLK); без FILE_LOCKING ядро отвечает ENOSYS и установка не стартует.
# Контракт пакетного менеджера дистрибутива — locks.c возвращается.
CONFIG_FILE_LOCKING=y
# и tmpfs: xbps проверяет свободное место через statfs цели установки.
# ramfs initramfs (и ramfs-заглушка tmpfs при SHMEM=n!) отдаёт 0 байт,
# транзакция прерывается; SHMEM обязателен: TMPFS depends on SHMEM,
# olddefconfig молча снимает TMPFS без него.
CONFIG_SHMEM=y
CONFIG_TMPFS=y

# --- M5: микроядерный IPC — транспорт серверов ------------------------------
# AF_UNIX — единственная сетевая подсистема, которую вернуло ядро: транспорт
# lane-сообщений между серверами (mlbus/logsrv). SOCK_SEQPACKET даёт атомарные
# сообщения, SCM_RIGHTS передаёт хэндлы. Протоколы (inet и прочее) остаются
# вырезанными: net/Kconfig у MiLin свой, минимальный.
# NET=y нужен явно: UNIX depends on NET, а olddefconfig молча снимет UNIX.
CONFIG_NET=y
CONFIG_UNIX=y
# loopback: net/core (dst.o, register_netdevice) ссылается на
# loopback_net_ops/blackhole_netdev — минимальный netdev-каркас
CONFIG_LOOPBACK=y
# BPF приходит по select-контракту NET (см. net/Kconfig); JIT не нужен —
# интерпретатора достаточно, ядру нечему фильтровать пакеты
CONFIG_BPF_SYSCALL=y
# select-хвост BPF_SYSCALL по контракту v7.2 (kernel/bpf/Kconfig):
CONFIG_NET_SOCK_MSG=y
CONFIG_NET_XGRESS=y
CONFIG_PAGE_POOL=y
# контракт v7.2: net/core/filter.o ссылается на хелперы BPF безусловно,
# поэтому BPF_SYSCALL=y — часть цены CONFIG_NET; JIT не нужен
# CONFIG_BPF_JIT is not set

# --- M9: kdriver-домен — драйверы «между ядром и userspace» ------------------
# каждый драйвер = отдельный kthread с очередью запросов (свой pid/стек,
# перезапуск при пробое); userspace говорит с ним через /dev/<name>:
# write = запрос, read = ответ. Размещение — политика: AUTO ставит драйвер
# в ядро (быстрый путь: обработка в ring 0, без перехода в чужой процесс),
# 'user' через /sys/class/mlkd/<name>/placement отдаёт его userspace-серверу
# (UIO-путь), 'kernel' возвращает в домен. kdemo — образец и бут-тест.
CONFIG_MILIN_KDRIVER=y
CONFIG_MILIN_KDRIVER_DEMO=y
# M11: фасад amdgpu — запросная плоскость GPU в домене (gpud — user-placement)
CONFIG_MILIN_AMDGPU_FACADE=y

# --- M5.1: асинхронные очереди HelQueue — контракт ожидания -----------------
# futex — примитив парковки очередей (аналог HelFutex из Managarm): producer
# будит consumer через FUTEX_WAKE на notify-слове очереди в разделяемой
# памяти. Без futex остались бы поллинг с yield или nanosleep-сон.
# тянет по select/imply: RT_MUTEXES + FUTEX_PI + FUTEX_PRIVATE_HASH (цена
# контракта,pi-варианты очередям не нужны, но отделяются только вместе с
# RT_MUTEXES — оставляем как есть).
CONFIG_FUTEX=y

# --- M12: pinned-DMA регион для userspace-драйверов --------------------------
# /dev/mlpinned: регион 4 МиБ резервируется из e820 (cmdline гостя обязан
# нести memmap=4M$0x8000000) — физика как факт машины, не арифметика
# page_to_phys: SPARSEMEM_VMEMMAP (тащится по select-контракту вместо
# запрошенного FLATMEM) врёт адресом, DMA NIC'а уходит в чужую память.
# mmap отдаёт регион процессу, ioctl возвращает базу. Плюс правило UIO:
# uio_pci_generic не ставит BUS MASTER — драйвер включает его сам через
# PCI config (offset 4, бит 2), иначе DMA молча читает нули.
CONFIG_MILIN_PINDMA=y
# M12: eventfd — примитив готовности netsh.so (socket-шима поверх
# ML_PROTO_NET): poll/read-семантика для сокетов, чьи данные ходят
# lane'ами. Без него glibc eventfd() даёт ENOSYS.
CONFIG_EVENTFD=y

# --- M14: энтропия для TLS (xbps -> https) ---------------------------------
# в VM-среде jitter-энтропия медленная (crng init ~60с: openssl умирает
# в getrandom до nginx-таймаута 60с); virtio-rng кормит hwrng мгновенно.
# реальное железо: RDRAND/RDSEED есть на любом современном x86.
CONFIG_HW_RANDOM=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- M14: бут-хранение и консоль реального железа ---------------------------
# сеть остаётся в userspace (netd через UIO); в ядро возвращается только то,
# без чего реальная машина не грузится: блочный стек (AHCI/NVMe/virtio-blk),
# ext4 (постоянный root) и текстовая консоль с клавиатурой (VGA/ATKBD).
# crypto — контракт ext4 (crc32c); procfs — контракт userspace-мира.
CONFIG_BLOCK=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_INPUT=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO_LIBPS2=y
CONFIG_SERIO_I8042=y

# --- M14: UEFI-загрузка с реального железа (GRUB EFI -> EFI stub) -----------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# M15: USB-клавиатуры на реальном железе (обратная резня: drivers/usb+hid)
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y

# --- M16: современный x86 — SMP, MSI, oneshot-таймеры -----------------------
# SMP: реальные CPU многоядерные; ядро с SMP=n поднимает один core и греет
# его поллингом netd. NR_CPUS обязателен руками: tinyconfig держит 1, и
# olddefconfig молча оставит его даже при SMP=y.
# PCI_MSI: NVMe/xHCI реальных плат хотят MSI/MSI-X (legacy-pin там часто
# не маршрутизирован); GENERIC_MSI_IRQ приходит по select, а
# IRQ_DOMAIN_HIERARCHY уже выбран X86_LOCAL_APIC. Честная оговорка аудита:
# LOCAL_APIC/IO-APIC/HPET/MPPARSE — def_bool y на x86_64 и были включены
# дефолтом с M1; флипаются только SMP/MSI/HIGH_RES.
# HIGH_RES_TIMERS: oneshot-режим clockevent (LAPIC/HPET) вместо PIT-периодики — на PIT-less чипсетах это единственный таймер вообще.
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_PCI_MSI=y
CONFIG_HIGH_RES_TIMERS=y

# --- M17: ACPI — MADT (AP-перечисление на современных машинах), _PRT
# (маршрутизация PCI INTx), MCFG (ECAM), S5 poweroff. Ядро ACPI-таблиц:
# boot.c в arch/x86/kernel/acpi цел с M1 — flips только сюда. ACPICA
# интерпретатор + pci_root/pci_link/pci_irq едут select'ами ACPI.
# PNP — select из ACPI (pnpacpi). Processor/AC/Battery/Button off:
# idle/P-состояния и кнопки — дела userspace-серверов, не микроядра.
CONFIG_ACPI=y
CONFIG_ACPI_MCFG=y
# CONFIG_ACPI_PROCESSOR is not set
# CONFIG_ACPI_AC is not set
# CONFIG_ACPI_BATTERY is not set
# CONFIG_ACPI_BUTTON is not set
# CONFIG_ACPI_DOCK is not set
