# MiLin kdrv: фрагмент поверх milin.config для сборки с настоящими драйверами.
# Замыкание Kconfig разворачивает ~47 опций (DRM core, TTM, scheduler, display
# helper, dma-buf, i2c, hwmon, power). Дефолтная диета (milin.config) не
# меняется; драйверы включаются только этой добавкой — docs/drivers.md.
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=y
CONFIG_FW_LOADER=y
